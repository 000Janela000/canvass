# LeadScout backend environment variables.
#
# Only DATABASE_URL is read from env. All API keys (Google Places, Google CSE,
# Facebook Graph) are configured at runtime via the Settings page in the UI
# and stored in the `settings` table in SQLite.

# Database (SQLite - no changes needed, auto-creates at backend/data/leads.db)
DATABASE_URL=sqlite:///./data/leads.db
